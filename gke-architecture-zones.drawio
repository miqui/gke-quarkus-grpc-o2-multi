        <mxCell id="l4" parent="1" style="fillColor=#F5F5F5;strokeColor=#666666;rounded=1;fontSize=11;html=1;whiteSpace=wrap;strokeColor=#B85450;strokeWidth=2;" value="Red border = single-zone dependency" vertex="1"><mxGeometry x="275" y="855" width="230" height="30" as="geometry"/></mxCell>
        <mxCell id="l5" parent="1" style="fillColor=#D5E8D4;strokeColor=#2E7D32;strokeWidth=3;fontStyle=1;rounded=1;fontSize=11;html=1;whiteSpace=wrap;" value="Thick green = API replica (spread)" vertex="1"><mxGeometry x="515" y="855" width="250" height="30" as="geometry"/></mxCell>
        <mxCell id="l6" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;" value="Blue = request path · red dashed = cross-zone hop (~0.5–1 ms, ~$0.01/GB)" vertex="1"><mxGeometry x="800" y="785" width="860" height="20" as="geometry"/></mxCell>
        <mxCell id="tb" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;b&gt;What survives what&lt;/b&gt;&lt;br&gt;• Node loss → replica rescheduled; 2 keep serving (hostname spread)&lt;br&gt;• Zone b or c loss → 2 replicas serve; LB drops that zone's NEG; but Hazelcast/Trivy/OpenObserve may be there&lt;br&gt;• Zone a loss → API pods elsewhere still up, but Cloud SQL + control plane down ⇒ effectively an outage&lt;br&gt;• Drain / upgrade → PDB keeps ≥ 2 replicas&lt;br&gt;&lt;font color='#B85450'&gt;&lt;b&gt;Observed 2026-10-16:&lt;/b&gt; 16:02 all 3 replicas landed in zone a (soft ScheduleAnyway lost to an empty new node); 16:27 the scale-down drained it under the PDB and they respread 1/1/1. Hard-spread fix documented, not applied: GKE-OPS.md.&lt;/font&gt;" vertex="1"><mxGeometry x="800" y="808" width="860" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
