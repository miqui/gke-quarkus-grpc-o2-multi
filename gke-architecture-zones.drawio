        <mxCell id="cl" parent="1" style="fillColor=#F3FAF3;strokeColor=#82B366;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=11;html=1;" value="GKE Standard dev-cluster · default-pool node-locations a,b,c · e2-standard-2 · autoscale 3–6 nodes TOTAL · location policy BALANCED&lt;br&gt;&lt;span style='font-weight:normal'&gt;job-manager-api: HPA 3–6 (CPU 70%) · PDB minAvailable 2 (k8s/pdb.yaml) · topologySpreadConstraints zone + hostname, maxSkew 1 · other platform pods are placed by the scheduler with no zone constraints&lt;/span&gt;" vertex="1"><mxGeometry x="280" y="195" width="1360" height="415" as="geometry"/></mxCell>
